# Copy this file to `.env` in the project root before running
# `docker compose up --build`. Never commit the real `.env`.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- PostgreSQL ----
# Used by both the `db` container and Django's DATABASES setting.
POSTGRES_DB=velora
POSTGRES_USER=velora
POSTGRES_PASSWORD=change-me

# ---- JWT ----
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# The refresh token is stored as an httpOnly cookie. `Secure` cookies are
# only sent over HTTPS — this stack is served over plain HTTP on
# localhost (no TLS termination here), so this must stay False for local
# evaluation. Flip to True behind real TLS in production.
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax

# ---- CORS ----
# Only matters when the frontend calls the backend cross-origin (e.g.
# `next dev` on :3000 talking to Django on :8000 directly, without
# Nginx). Behind Nginx (docker compose) frontend and backend share an
# origin, so this is unused but harmless to leave set.
CORS_ALLOWED_ORIGINS=http://localhost:3000

FRONTEND_URL=http://localhost:3000

# ---- GitHub OAuth ----
# Create an OAuth App at https://github.com/settings/developers with:
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ---- Frontend build args ----
# Baked into the client bundle at build time. Empty API URL means
# "same origin" — correct when Nginx proxies /api to the backend.
NEXT_PUBLIC_API_URL=
